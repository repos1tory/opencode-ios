<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.alsinas.opencode-server</string>
    <key>ProgramArguments</key>
    <array>
      <string>/var/jb/usr/lib/opencode-ios/server.sh</string>
    </array>
    <key>UserName</key>
    <string>mobile</string>
    <key>GroupName</key>
    <string>mobile</string>
    <key>WorkingDirectory</key>
    <string>/var/jb/var/mobile</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>HOME</key>
      <string>/var/jb/var/mobile</string>
      <key>XDG_CACHE_HOME</key>
      <string>/var/jb/var/mobile/.cache</string>
      <key>XDG_CONFIG_HOME</key>
      <string>/var/jb/var/mobile/.config</string>
      <key>XDG_DATA_HOME</key>
      <string>/var/jb/var/mobile/.local/share</string>
      <key>XDG_STATE_HOME</key>
      <string>/var/jb/var/mobile/.local/state</string>
      <key>OPENCODE_DATA_HOME</key>
      <string>/var/jb/var/mobile/.local/share</string>
      <key>OPENCODE_DB</key>
      <string>/var/jb/var/mobile/.local/share/opencode/opencode-ios-port.db</string>
      <key>OPENCODE_CONFIG_DIR</key>
      <string>/var/jb/var/mobile/.config/opencode</string>
      <key>TMPDIR</key>
      <string>/private/var/tmp</string>
      <key>PATH</key>
      <string>/var/jb/usr/bin:/var/jb/usr/sbin:/var/jb/bin:/usr/bin:/bin</string>
      <key>SHELL</key>
      <string>/var/jb/usr/bin/zsh</string>
    </dict>
    <key>KeepAlive</key>
    <dict>
      <key>PathState</key>
      <dict>
        <key>/var/mobile/.config/opencode-ios/server.enabled</key>
        <true/>
      </dict>
    </dict>
    <key>AbandonProcessGroup</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>15</integer>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>Umask</key>
    <integer>63</integer>
    <key>StandardOutPath</key>
    <string>/var/mobile/Library/Logs/OpenCode/server.log</string>
    <key>StandardErrorPath</key>
    <string>/var/mobile/Library/Logs/OpenCode/server.err.log</string>
  </dict>
</plist>
