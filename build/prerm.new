#!/var/jb/bin/sh
set -e

if [ "${1:-}" = remove ] || [ "${1:-}" = deconfigure ]; then
  /var/jb/usr/bin/launchctl bootout user/501/com.alsinas.opencode-expose-proxy 2>/dev/null || true
  /var/jb/usr/bin/launchctl bootout user/501/com.alsinas.opencode-server 2>/dev/null || true
  /var/jb/usr/bin/uicache -u /var/jb/Applications/OpenCode.app 2>/dev/null || true
fi
if [ "${1:-}" = remove ] || [ "${1:-}" = deconfigure ]; then
  /var/jb/usr/bin/launchctl bootout system/com.alsinas.opencode-watchdog 2>/dev/null || true
  /var/jb/usr/bin/rm -f /var/mobile/.config/opencode-ios/server.enabled \
    /var/mobile/.config/opencode-ios/relay.enabled
fi

exit 0
