@@ -0,0 +1,56 @@
+import { spawn } from "node:child_process"
+import { EventEmitter } from "node:events"
+import { StringDecoder } from "node:string_decoder"
+import type { Opts, Proc } from "./pty"
+
+export function open(file: string, args: string[], opts: Opts): Proc {
+  const helper = process.env.OPENCODE_IOS_PTY_HELPER
+  if (!helper) throw new Error("OPENCODE_IOS_PTY_HELPER is required for iOS terminals")
+  const child = spawn(helper, [String(opts.cols ?? 80), String(opts.rows ?? 24), file, ...args], {
+    cwd: opts.cwd,
+    env: { ...process.env, ...opts.env, TERM: opts.name },
+    stdio: ["pipe", "pipe", "pipe"],
+  })
+  const events = new EventEmitter()
+  const decoder = new StringDecoder("utf8")
+  let error = ""
+  child.stderr.on("data", (data: Buffer) => { error = (error + data.toString()).slice(-4096) })
+  child.stdout.on("data", (data: Buffer) => events.emit("data", decoder.write(data)))
+  child.on("error", (cause) => { error = cause.message })
+  child.on("close", (code, signal) => {
+    const tail = decoder.end()
+    if (tail) events.emit("data", tail)
+    if (error) events.emit("data", error)
+    events.emit("exit", { exitCode: code ?? 1, ...(signal ? { signal } : {}) })
+  })
+  child.stdin.on("error", () => {})
+  function frame(type: number, data: Buffer) {
+    if (!child.stdin.writable) return
+    const header = Buffer.alloc(5)
+    header.writeUInt32BE(data.length + 1)
+    header[4] = type
+    if (data.length > 65536 || child.stdin.writableLength + data.length + 5 > 1024 * 1024) {
+      child.kill("SIGTERM")
+      throw new Error("iOS terminal input exceeded its queue limit")
+    }
+    child.stdin.write(Buffer.concat([header, data]))
+  }
+  return {
+    pid: child.pid ?? -1,
+    onData(listener) { events.on("data", listener); return { dispose: () => { events.off("data", listener) } } },
+    onExit(listener) { events.on("exit", listener); return { dispose: () => { events.off("exit", listener) } } },
+    write(data) {
+      const bytes = Buffer.from(data)
+      for (let offset = 0; offset < bytes.length; offset += 65536) frame(73, bytes.subarray(offset, offset + 65536))
+    },
+    resize(cols, rows) {
+      const size = Buffer.alloc(4)
+      size.writeUInt16BE(Math.max(1, Math.min(65535, cols)), 0)
+      size.writeUInt16BE(Math.max(1, Math.min(65535, rows)), 2)
+      frame(82, size)
+    },
+    kill(signal = "SIGTERM") { child.kill(signal as NodeJS.Signals) },
+  }
+}
+
+export * as IosPty from "./pty.ios"
